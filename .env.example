# URL base del API (opcional, por defecto apunta al servidor en Railway)
# VITE_API_URL=https://proyectofinalitlabackend-production.up.railway.app/api

# Google OAuth Client ID - Obtenlo en https://console.cloud.google.com
# 1. Crea un proyecto en Google Cloud Console
# 2. Ve a "APIs y Servicios" > "Credenciales"
# 3. Crea un "ID de cliente de OAuth 2.0" de tipo "Aplicación web"
# 4. Agrega http://localhost:5173 como "Origen de JavaScript autorizado"
# 5. Copia el "ID de cliente" y pégalo abajo
VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI
